# Copy to .env — everything is optional; with no .env the app runs monitor-only.

# HTTP port for the server + dashboard (default 8788)
#PORT=8788

# ---------------------------------------------------------------------------
# Optional manual trading (OFF by default).
# Polysignal has NO automated trading loop; enabling this only unlocks the
# one-click manual order panel in the dashboard.
# ---------------------------------------------------------------------------
#TRADING_ENABLED=true

# Your Polymarket wallet private key (0x...). For accounts created with
# email/Magic, export it from Polymarket: profile -> settings -> export key.
# The key is only used locally to sign CLOB orders.
#POLYMARKET_PRIVATE_KEY=0x...

# The address that holds your USDC on Polymarket (your profile/deposit
# address, a proxy wallet). Required for email or browser-wallet accounts.
#POLYMARKET_FUNDER_ADDRESS=0x...

# Signature type: 1 = email/Magic account (proxy), 2 = browser-wallet
# account (Gnosis Safe proxy), 0 = direct EOA (advanced).
#POLYMARKET_SIGNATURE_TYPE=1

# Fee rate charged on winnings, as a fraction (updown markets are currently
# feeless; set this if Polymarket introduces fees, e.g. 0.02).
#FEE_RATE=0
