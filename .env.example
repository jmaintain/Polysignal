# Copy to .env — everything is optional; with no .env the app runs
# monitor-only using public REST market data (order books poll at ~2s).

# HTTP port for the server + dashboard (default 8788)
#PORT=8788

# ---------------------------------------------------------------------------
# Kalshi API key (free with any Kalshi account: Settings -> API keys).
# Unlocks the authenticated websocket (sub-second full-depth order books)
# and, together with TRADING_ENABLED, the manual trading panel.
# ---------------------------------------------------------------------------
#KALSHI_API_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#KALSHI_PRIVATE_KEY_PATH=./kalshi-key.pem
# (or paste the PEM inline instead of a path:)
#KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ---------------------------------------------------------------------------
# Optional manual trading (OFF by default). Polysignal has NO automated
# trading loop; this only unlocks the one-click manual order panel.
# ---------------------------------------------------------------------------
#TRADING_ENABLED=true

# Kalshi taker fee rate (fee = rate * P * (1-P) per contract). Default 0.07.
#KALSHI_FEE_RATE=0.07

# Pin a series ticker if auto-discovery picks the wrong one, e.g.:
#KALSHI_SERIES_BTC_15M=KXBTC15M
#KALSHI_SERIES_ETH_1H=...
#KALSHI_SERIES_SOL_1D=...
